  @@index([tenantId, status])
  @@index([tenantId, partyId])
}

model QuotationLine {
  id           String    @id @default(uuid())
  tenantId     String
  quotationId  String
  productId    String
  description  String
  qty          Decimal   @db.Decimal(14, 4)
  unitPrice    Decimal   @db.Decimal(14, 2)
  discountPct  Decimal   @default(0) @db.Decimal(5, 2)
  taxRate      Decimal   @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal   @db.Decimal(14, 2)
  taxAmount    Decimal   @db.Decimal(14, 2)
  lineTotal    Decimal   @db.Decimal(14, 2)
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, quotationId])
}

model SalesOrder {
  id             String           @id @default(uuid())
  tenantId       String
  branchId       String
  fiscalYearId   String
  warehouseId    String
  partyId        String
  quotationId    String?
  number         String
  status         SalesOrderStatus @default(DRAFT)
  orderDate      DateTime         @default(now())
  currency       String           @default("INR")
  subtotal       Decimal          @default(0) @db.Decimal(14, 2)
  discountAmount Decimal          @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal          @default(0) @db.Decimal(14, 2)
  total          Decimal          @default(0) @db.Decimal(14, 2)
  notes          String?
  reservedAt     DateTime?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  fiscalYear     FiscalYear       @relation(fields: [fiscalYearId], references: [id])
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id])
  party          Party            @relation(fields: [partyId], references: [id])
  quotation      Quotation?       @relation(fields: [quotationId], references: [id])
  lines          SalesOrderLine[]
  reservations   StockReservation[]
  invoices       Invoice[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
}

model SalesOrderLine {
  id           String     @id @default(uuid())
  tenantId     String
  salesOrderId String
