model PurchaseOrderLine {
  id          String        @id @default(uuid())
  tenantId    String
  purchaseOrderId String
  productId   String
  description String
  qty         Decimal       @db.Decimal(14, 4)
  qtyReceived Decimal       @default(0) @db.Decimal(14, 4)
  unitPrice   Decimal       @db.Decimal(14, 2)
  taxRate     Decimal       @default(0) @db.Decimal(5, 2)
  lineSubtotal Decimal      @db.Decimal(14, 2)
  taxAmount   Decimal       @db.Decimal(14, 2)
  lineTotal   Decimal       @db.Decimal(14, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, purchaseOrderId])
}

model Quotation {
  id             String          @id @default(uuid())
  tenantId       String
  branchId       String
  fiscalYearId   String
  warehouseId    String?
  partyId        String
  opportunityId  String?
  number         String
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  currency       String          @default("INR")
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  discountAmount Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(14, 2)
  total          Decimal         @default(0) @db.Decimal(14, 2)
  notes          String?
  revisionOfId   String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  fiscalYear     FiscalYear      @relation(fields: [fiscalYearId], references: [id])
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id])
  party          Party           @relation(fields: [partyId], references: [id])
  opportunity    Opportunity?    @relation(fields: [opportunityId], references: [id])
  revisionOf     Quotation?      @relation("QuotationRevision", fields: [revisionOfId], references: [id])
  revisions      Quotation[]     @relation("QuotationRevision")
  lines          QuotationLine[]
  salesOrders    SalesOrder[]
  deletedAt DateTime?
  deletedBy String?

