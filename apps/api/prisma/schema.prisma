generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  GRACE
  READ_ONLY
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum PermissionAction {
  view
  create
  edit
  approve
  cancel
  export
  administer
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
}

model Plan {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  userLimit          Int      @default(25)
  branchLimit        Int      @default(3)
  storageGb          Int      @default(10)
  whatsappMonthlyCap Int      @default(1000)
  documentMonthlyCap Int      @default(5000)
  modules            Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenants            Tenant[]
}

model Tenant {
  id                    String       @id @default(uuid())
  name                  String
  slug                  String       @unique
  legalName             String?
  status                TenantStatus @default(TRIAL)
  planId                String?
  locale                String       @default("en-IN")
  timezone              String       @default("Asia/Kolkata")
  currency              String       @default("INR")
  taxRegime             String       @default("IN_GST")
  trialEndsAt           DateTime?
  graceEndsAt           DateTime?
  retentionDays         Int          @default(90)
  legalHold             Boolean      @default(false)
  deletionScheduledAt   DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  plan                  Plan?        @relation(fields: [planId], references: [id])
  branches              Branch[]
  departments           Department[]
  memberships           Membership[]
  roles                 Role[]
  settings              TenantSetting[]
  fiscalYears           FiscalYear[]
  sequences             DocumentSequence[]
  customFields          CustomField[]
  tags                  Tag[]
  statuses              StatusDefinition[]
  approvalPolicies      ApprovalPolicy[]
  auditEvents           AuditEvent[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  sessions              UserSession[]
  supportAccess         SupportAccess[]
  jobs                  JobExecution[]
  tasks                 Task[]
  recurringTaskRules    RecurringTaskRule[]
  parties               Party[]
  contacts              Contact[]
  leads                 Lead[]
  opportunities         Opportunity[]
  activities            Activity[]
  productCategories     ProductCategory[]
  products              Product[]
  productVariants       ProductVariant[]
  priceLists            PriceList[]
  partyPrices           PartyPrice[]
  warehouses            Warehouse[]
  stockBalances         StockBalance[]
  stockMovements        StockMovement[]
  stockReservations     StockReservation[]
  serialLots            SerialLot[]
  purchaseOrders        PurchaseOrder[]
  quotations            Quotation[]
  salesOrders           SalesOrder[]
  salesTargets          SalesTarget[]
  ledgerAccounts        LedgerAccount[]
  accountOpenings       AccountOpening[]
  invoices              Invoice[]
  payments              Payment[]
  vouchers              Voucher[]
  designations          Designation[]
  shifts                Shift[]
  holidays              Holiday[]
  employees             Employee[]
  attendances           Attendance[]
  leavePolicies         LeavePolicy[]
  leaveRequests         LeaveRequest[]
  salaryStructures      SalaryStructure[]
  payrollRuns           PayrollRun[]
  incentiveSchemes      IncentiveScheme[]
  incentiveAwards       IncentiveAward[]
  serviceTickets        ServiceTicket[]
  pickLists             PickList[]
  shipments             Shipment[]
  recurringSchedules    RecurringSchedule[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]
  channelAccounts       ChannelAccount[]
  conversations         Conversation[]
  marketplaceListings   MarketplaceListing[]
  marketplaceOrders     MarketplaceOrder[]
  webhookEvents         WebhookEvent[]
  importBatches         ImportBatch[]
  exportJobs            ExportJob[]
  reportRuns            ReportRun[]
  mobileDevices         MobileDevice[]
  offlineActions        OfflineAction[]
  workAssignments       WorkAssignment[]
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  displayName      String
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?   @default("IN")
  isPlatformAdmin  Boolean   @default(false)
  isActive         Boolean   @default(true)
  mfaEnabled       Boolean   @default(false)
  lastLoginAt      DateTime?
  deactivatedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships      Membership[]
  sessions         UserSession[]
  auditEvents      AuditEvent[]  @relation("AuditActor")
  notifications    Notification[]
  notificationPrefs NotificationPreference[]
  supportGranted   SupportAccess[] @relation("SupportActor")
  supportTarget    SupportAccess[] @relation("SupportTarget")
  ownedTasks       Task[]          @relation("TaskOwner")
  createdTasks     Task[]          @relation("TaskCreator")
  taskComments     TaskComment[]
  taskTimeLogs     TaskTimeLog[]
  taskWatchers     TaskWatcher[]
  ownedLeads       Lead[]          @relation("LeadOwner")
  ownedOpps        Opportunity[]   @relation("OpportunityOwner")
  activities       Activity[]
  employees        Employee[]
}

model Branch {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  isDefault   Boolean  @default(false)
  timezone    String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  memberships Membership[]
  membershipScopes MembershipBranch[]
  sequences   DocumentSequence[]
  policies    ApprovalPolicy[]
  tasks       Task[]
  leads       Lead[]
  warehouses  Warehouse[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  purchaseOrders PurchaseOrder[]
  invoices    Invoice[]
  payments    Payment[]
  vouchers    Voucher[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  memberships Membership[]
  policies    ApprovalPolicy[]
  tasks       Task[]
  salesTargets SalesTarget[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Membership {
  id              String           @id @default(uuid())
  tenantId        String
  userId          String
  departmentId    String?
  defaultBranchId String?
  status          MembershipStatus @default(INVITED)
  invitedAt       DateTime         @default(now())
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  defaultBranch   Branch?          @relation(fields: [defaultBranchId], references: [id])
  roles           MembershipRole[]
  branchScopes    MembershipBranch[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships MembershipRole[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id        String           @id @default(uuid())
  key       String           @unique
  module    String
  action    PermissionAction
  label     String
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  roleId       String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model MembershipBranch {
  membershipId String
  branchId     String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
}

model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, key])
  @@index([tenantId])
}

model FiscalYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  startsOn  DateTime
  endsOn    DateTime
  isCurrent Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sequences DocumentSequence[]
  quotations Quotation[]
  salesOrders SalesOrder[]
  purchaseOrders PurchaseOrder[]
  invoices  Invoice[]
  vouchers  Voucher[]
  accountOpenings AccountOpening[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model DocumentSequence {
  id           String     @id @default(uuid())
  tenantId     String
  branchId     String
  fiscalYearId String
  documentType String
  prefix       String
  nextNumber   Int        @default(1)
  padding      Int        @default(5)
  updatedAt    DateTime   @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  branch       Branch     @relation(fields: [branchId], references: [id])
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, branchId, fiscalYearId, documentType])
  @@index([tenantId])
}

model CustomField {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  key        String
  label      String
  fieldType  String
  required   Boolean  @default(false)
  options    Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, entityType, key])
  @@index([tenantId])
}

model Tag {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  name       String
  color      String   @default("#0F766E")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, entityType, name])
  @@index([tenantId])
}

model StatusDefinition {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  code       String
  label      String
  color      String   @default("#64748B")
  sortOrder  Int      @default(0)
  isTerminal Boolean  @default(false)
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, entityType, code])
  @@index([tenantId])
}

model ApprovalPolicy {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  documentType String
  minAmount    Decimal  @default(0) @db.Decimal(14, 2)
  maxAmount    Decimal? @db.Decimal(14, 2)
  departmentId String?
  branchId     String?
  requiredRole String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  branch       Branch?     @relation(fields: [branchId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, documentType])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  tenantId         String?
  refreshTokenHash String    @unique
  familyId         String
  ip               String?
  userAgent        String?
  deviceLabel      String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant           Tenant?   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([userId])
  @@index([tenantId])
  @@index([familyId])
}

model SupportAccess {
  id          String    @id @default(uuid())
  tenantId    String
  actorUserId String
  targetUserId String?
  reason      String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  actor       User      @relation("SupportActor", fields: [actorUserId], references: [id])
  target      User?     @relation("SupportTarget", fields: [targetUserId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, expiresAt])
}

model AuditEvent {
  id            String   @id @default(uuid())
  tenantId      String?
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  previous      Json?
  next          Json?
  ip            String?
  userAgent     String?
  device        String?
  correlationId String?
  createdAt     DateTime @default(now())

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Notification {
  id        String              @id @default(uuid())
  tenantId  String
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  entityType String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  user      User                @relation(fields: [userId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, userId, createdAt])
}

model NotificationPreference {
  id        String              @id @default(uuid())
  tenantId  String
  userId    String
  eventKey  String
  channel   NotificationChannel
  enabled   Boolean             @default(true)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  user      User                @relation(fields: [userId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, userId, eventKey, channel])
  @@index([tenantId])
}

model JobExecution {
  id            String    @id @default(uuid())
  tenantId      String
  queue         String
  jobName       String
  idempotencyKey String
  correlationId String?
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  payload       Json
  error         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, queue, status])
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
}

enum LeadStatus {
  NEW
  QUALIFIED
  CONVERTED
  LOST
}

enum OpportunityStage {
  QUALIFY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProductType {
  GOODS
  SERVICE
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  CONVERTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  APPROVED
  RESERVED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum InvoiceKind {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  POSTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  CANCELLED
}

enum VoucherType {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  CONTRA
  JOURNAL
  DEBIT_NOTE
  CREDIT_NOTE
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
}

enum PaymentMethod {
  CASH
  BANK
  UPI
  CARD
  CHEQUE
  OTHER
}

model RecurringTaskRule {
  id          String              @id @default(uuid())
  tenantId    String
  title       String
  description String?
  frequency   RecurrenceFrequency
  interval    Int                 @default(1)
  nextRunAt   DateTime
  isActive    Boolean             @default(true)
  ownerUserId String?
  priority    TaskPriority        @default(NORMAL)
  template    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  tasks       Task[]
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, nextRunAt])
}

model Task {
  id              String       @id @default(uuid())
  tenantId        String
  number          String
  title           String
  description     String?
  status          TaskStatus   @default(OPEN)
  priority        TaskPriority @default(NORMAL)
  ownerUserId     String?
  createdByUserId String
  branchId        String?
  departmentId    String?
  dueAt           DateTime?
  slaDueAt        DateTime?
  completedAt     DateTime?
  parentId        String?
  recurrenceId    String?
  linkedEntityType String?
  linkedEntityId  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  owner           User?        @relation("TaskOwner", fields: [ownerUserId], references: [id])
  createdBy       User         @relation("TaskCreator", fields: [createdByUserId], references: [id])
  branch          Branch?      @relation(fields: [branchId], references: [id])
  department      Department?  @relation(fields: [departmentId], references: [id])
  parent          Task?        @relation("TaskTree", fields: [parentId], references: [id])
  children        Task[]       @relation("TaskTree")
  recurrence      RecurringTaskRule? @relation(fields: [recurrenceId], references: [id])
  checklist       TaskChecklistItem[]
  comments        TaskComment[]
  watchers        TaskWatcher[]
  timeLogs        TaskTimeLog[]
  blockedBy       TaskDependency[] @relation("TaskBlocked")
  blocks          TaskDependency[] @relation("TaskBlocks")
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, number])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, linkedEntityType, linkedEntityId])
}

model TaskChecklistItem {
  id        String   @id @default(uuid())
  tenantId  String
  taskId    String
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, taskId])
}

model TaskComment {
  id           String   @id @default(uuid())
  tenantId     String
  taskId       String
  authorUserId String
  body         String
  mentions     Json?
  createdAt    DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User     @relation(fields: [authorUserId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, taskId, createdAt])
}

model TaskWatcher {
  tenantId String
  taskId   String
  userId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

  @@id([taskId, userId])
  @@index([tenantId])
}

model TaskDependency {
  tenantId        String
  taskId          String
  dependsOnTaskId String
  task            Task   @relation("TaskBlocked", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task   @relation("TaskBlocks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

  @@id([taskId, dependsOnTaskId])
  @@index([tenantId])
}

model TaskTimeLog {
  id        String   @id @default(uuid())
  tenantId  String
  taskId    String
  userId    String
  minutes   Int
  workDate  DateTime
  note      String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, taskId])
  @@index([tenantId, userId, workDate])
}

model Party {
  id               String    @id @default(uuid())
  tenantId         String
  type             PartyType @default(CUSTOMER)
  code             String
  name             String
  legalName        String?
  email            String?
  phone            String?
  taxId            String?
  normalizedEmail  String?
  normalizedPhone  String?
  normalizedTaxId  String?
  billingAddress   String?
  shippingAddress  String?
  creditLimit      Decimal   @default(0) @db.Decimal(14, 2)
  paymentTermsDays Int       @default(0)
  priceListId      String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  priceList        PriceList? @relation(fields: [priceListId], references: [id])
  contacts         Contact[]
  leads            Lead[]
  opportunities    Opportunity[]
  activities       Activity[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  payments         Payment[]
  partyPrices      PartyPrice[]
  journalLines     JournalLine[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, code])
  @@index([tenantId, type, name])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, normalizedEmail])
  @@index([tenantId, normalizedTaxId])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  partyId   String
  name      String
  email     String?
  phone     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, partyId])
}

model Lead {
  id              String     @id @default(uuid())
  tenantId        String
  branchId        String?
  name            String
  email           String?
  phone           String?
  company         String?
  source          String     @default("manual")
  status          LeadStatus @default(NEW)
  ownerUserId     String?
  value           Decimal    @default(0) @db.Decimal(14, 2)
  probability     Int        @default(10)
  nextFollowUpAt  DateTime?
  lostReason      String?
  notes           String?
  normalizedEmail String?
  normalizedPhone String?
  convertedPartyId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  branch          Branch?    @relation(fields: [branchId], references: [id])
  owner           User?      @relation("LeadOwner", fields: [ownerUserId], references: [id])
  convertedParty  Party?     @relation(fields: [convertedPartyId], references: [id])
  opportunities   Opportunity[]
  activities      Activity[]
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@index([tenantId, normalizedPhone])
  @@index([tenantId, normalizedEmail])
}

model Opportunity {
  id             String            @id @default(uuid())
  tenantId       String
  partyId        String
  leadId         String?
  name           String
  stage          OpportunityStage  @default(QUALIFY)
  probability    Int               @default(20)
  value          Decimal           @default(0) @db.Decimal(14, 2)
  ownerUserId    String?
  expectedCloseAt DateTime?
  lostReason     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  party          Party             @relation(fields: [partyId], references: [id])
  lead           Lead?             @relation(fields: [leadId], references: [id])
  owner          User?             @relation("OpportunityOwner", fields: [ownerUserId], references: [id])
  quotations     Quotation[]
  activities     Activity[]
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, stage])
  @@index([tenantId, partyId])
}

model Activity {
  id             String   @id @default(uuid())
  tenantId       String
  partyId        String?
  leadId         String?
  opportunityId  String?
  kind           String
  title          String
  body           String?
  occurredAt     DateTime @default(now())
  actorUserId    String?
  entityType     String?
  entityId       String?

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  party          Party?   @relation(fields: [partyId], references: [id])
  lead           Lead?    @relation(fields: [leadId], references: [id])
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  actor          User?    @relation(fields: [actorUserId], references: [id])
  deletedAt DateTime?
  deletedBy String?

  @@index([tenantId, partyId, occurredAt])
  @@index([tenantId, leadId, occurredAt])
  @@index([tenantId, entityType, entityId])
}

model ProductCategory {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  parentId  String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  parent    ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id          String      @id @default(uuid())
  tenantId    String
  sku         String
  name        String
  type        ProductType @default(GOODS)
  categoryId  String?
  unit        String      @default("NOS")
  barcode     String?
  taxRate     Decimal     @default(18) @db.Decimal(5, 2)
  unitPrice   Decimal     @default(0) @db.Decimal(14, 2)
  costPrice   Decimal     @default(0) @db.Decimal(14, 2)
  reorderLevel Decimal    @default(0) @db.Decimal(14, 4)
  trackStock  Boolean     @default(true)
  trackSerial Boolean     @default(false)
  trackBatch  Boolean     @default(false)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  priceItems  PriceListItem[]
  partyPrices PartyPrice[]
  quotationLines QuotationLine[]
  salesOrderLines SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines InvoiceLine[]
  stockBalances StockBalance[]
  stockMovements StockMovement[]
  stockReservations StockReservation[]
  serialLots  SerialLot[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, sku])
  @@index([tenantId, name])
}

model ProductVariant {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  sku       String
  name      String
  barcode   String?
  isDefault Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
}

model PriceList {
  id        String         @id @default(uuid())
  tenantId  String
  code      String
  name      String
  currency  String         @default("INR")
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  items     PriceListItem[]
  parties   Party[]
  deletedAt DateTime?
  deletedBy String?

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PriceListItem {
  id         String    @id @default(uuid())
  tenantId   String
  priceListId String
  productId  String
  price      Decimal   @db.Decimal(14, 2)
  priceList  PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

  @@unique([priceListId, productId])
  @@index([tenantId])
}

model PartyPrice {
  id        String  @id @default(uuid())
  tenantId  String
  partyId   String
  productId String
  price     Decimal @db.Decimal(14, 2)
