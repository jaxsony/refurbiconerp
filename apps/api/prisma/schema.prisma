enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceSource {
  WEB
  MOBILE
  BIOMETRIC
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY
  HALF_DAY
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PREVIEWED
  APPROVED
  LOCKED
  PUBLISHED
}

enum IncentiveFormula {
  FIXED
  PERCENTAGE
  SLAB
  TARGET
  MARGIN
  SCORE
}

enum IncentiveAwardStatus {
  CALCULATED
  HELD
  APPROVED
  PAID
  REVERSED
}

enum TicketStatus {
  RECEIVED
  INSPECTION
  ESTIMATE
  CUSTOMER_APPROVAL
  REPAIR
  QUALITY_CHECK
  READY_FOR_DISPATCH
  DELIVERED
  CANCELLED
}

enum RmaPath {
  WARRANTY
  PAID_REPAIR
  REPLACEMENT
  REFUND
  VENDOR_RMA
}

enum ShipmentStatus {
  CREATED
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  RTO
}

enum RecurringKind {
  RENT
  SALARY
  AMC
  SUBSCRIPTION
  UTILITY
  EMI
  OTHER
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

enum BankMatchStatus {
  UNMATCHED
  SUGGESTED
  CONFIRMED
  REJECTED
  SPLIT
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  CLOSED
}

model Designation {
  id        String     @id @default(uuid())
  tenantId  String
  code      String
  name      String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  employees Employee[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, code])
}

model Shift {
  id         String     @id @default(uuid())
  tenantId   String
  code       String
  name       String
  startTime  String
  endTime    String
  weeklyOffs Json
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  employees  Employee[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, code])
}

model Holiday {
  id       String   @id @default(uuid())
  tenantId String
  name     String
  date     DateTime
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, date])
}

model Employee {
  id             String           @id @default(uuid())
  tenantId       String
  userId         String?
  code           String
  name           String
  email          String?
  phone          String?
  departmentId   String?
  designationId  String?
  branchId       String?
  shiftId        String?
  joiningDate    DateTime
  status         EmploymentStatus @default(ACTIVE)
  bankAccount    String?
  ifsc           String?
  pan            String?
  emergencyName  String?
  emergencyPhone String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  user           User?            @relation(fields: [userId], references: [id])
  designation    Designation?     @relation(fields: [designationId], references: [id])
  shift          Shift?           @relation(fields: [shiftId], references: [id])
  attendances    Attendance[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  structures     SalaryStructure[]
  payrollLines   PayrollLine[]
  incentiveAwards IncentiveAward[]
  tickets        ServiceTicket[]
  assignments    WorkAssignment[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model Attendance {
  id          String           @id @default(uuid())
  tenantId    String
  employeeId  String
  workDate    DateTime
  source      AttendanceSource @default(WEB)
  status      AttendanceStatus @default(PRESENT)
  clockInAt   DateTime?
  clockOutAt  DateTime?
  latitude    Decimal?         @db.Decimal(10, 6)
  longitude   Decimal?         @db.Decimal(10, 6)
  selfieUrl   String?
  lateMinutes Int              @default(0)
  otMinutes   Int              @default(0)
  paidDay     Decimal          @default(1) @db.Decimal(4, 2)
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  employee    Employee         @relation(fields: [employeeId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, workDate])
}

model LeavePolicy {
  id          String         @id @default(uuid())
  tenantId    String
  code        String
  name        String
  annualDays  Decimal        @db.Decimal(6, 2)
  encashable  Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  balances    LeaveBalance[]
  requests    LeaveRequest[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, code])
}

model LeaveBalance {
  id         String      @id @default(uuid())
  tenantId   String
  employeeId String
  policyId   String
  year       Int
  opening    Decimal     @db.Decimal(6, 2)
  used       Decimal     @default(0) @db.Decimal(6, 2)
  employee   Employee    @relation(fields: [employeeId], references: [id])
  policy     LeavePolicy @relation(fields: [policyId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, employeeId, policyId, year])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  tenantId   String
  employeeId String
  policyId   String
  fromDate   DateTime
  toDate     DateTime
  days       Decimal     @db.Decimal(6, 2)
  reason     String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  employee   Employee    @relation(fields: [employeeId], references: [id])
  policy     LeavePolicy @relation(fields: [policyId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, status])
}

model SalaryStructure {
  id         String                @id @default(uuid())
  tenantId   String
  employeeId String
  effectiveFrom DateTime
  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  employee   Employee              @relation(fields: [employeeId], references: [id])
  lines      SalaryStructureLine[]
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, employeeId])
}

model SalaryStructureLine {
  id          String          @id @default(uuid())
  structureId String
  component   String
  kind        String
  amount      Decimal         @db.Decimal(14, 2)
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
}

model PayrollRun {
  id         String        @id @default(uuid())
  tenantId   String
  periodStart DateTime
  periodEnd  DateTime
  status     PayrollStatus @default(DRAFT)
  workingDays Int          @default(26)
  createdAt  DateTime      @default(now())
  lockedAt   DateTime?
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  lines      PayrollLine[]
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, status])
}

model PayrollLine {
  id           String     @id @default(uuid())
  tenantId     String
  runId        String
  employeeId   String
  paidDays     Decimal    @db.Decimal(6, 2)
  earnings     Decimal    @db.Decimal(14, 2)
  deductions   Decimal    @db.Decimal(14, 2)
  incentives   Decimal    @db.Decimal(14, 2)
  netPay       Decimal    @db.Decimal(14, 2)
  trace        Json
  publishedAt  DateTime?
  run          PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([runId, employeeId])
}

model IncentiveScheme {
  id            String          @id @default(uuid())
  tenantId      String
  name          String
  formula       IncentiveFormula
  rate          Decimal         @default(0) @db.Decimal(8, 4)
  holdUntilPaid Boolean         @default(true)
  isActive      Boolean         @default(true)
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  awards        IncentiveAward[]
  deletedAt DateTime?
  deletedBy String?

}

model IncentiveAward {
  id          String               @id @default(uuid())
  tenantId    String
  schemeId    String
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal              @db.Decimal(14, 2)
  status      IncentiveAwardStatus @default(CALCULATED)
  trace       Json
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  scheme      IncentiveScheme      @relation(fields: [schemeId], references: [id])
  employee    Employee             @relation(fields: [employeeId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, employeeId, periodStart])
}

model ServiceTicket {
  id           String       @id @default(uuid())
  tenantId     String
  number       String
  partyId      String
  productId    String?
  serialNo     String?
  complaint    String
  status       TicketStatus @default(RECEIVED)
  path         RmaPath      @default(PAID_REPAIR)
  priority     String       @default("NORMAL")
  technicianId String?
  slaDueAt     DateTime?
  estimate     Decimal      @default(0) @db.Decimal(14, 2)
  authorizedAt DateTime?
  qcPassedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  technician   Employee?    @relation(fields: [technicianId], references: [id])
  diagnoses    Diagnosis[]
  parts        TicketPart[]
  qualityChecks QualityCheck[]
  shipments    Shipment[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model WorkAssignment {
  id          String    @id @default(uuid())
  tenantId    String
  kind        String
  recordId    String
  step        String
  employeeId  String
  notes       String?
  allottedBy  String?
  allottedAt  DateTime  @default(now())
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  employee    Employee  @relation(fields: [employeeId], references: [id])
  deletedAt   DateTime?
  deletedBy   String?
  @@index([tenantId, kind, recordId])
  @@index([tenantId, employeeId])
}

model Diagnosis {
  id        String        @id @default(uuid())
  tenantId  String
  ticketId  String
  notes     String
  images    Json?
  createdAt DateTime      @default(now())
  ticket    ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

}

model TicketPart {
  id         String        @id @default(uuid())
  tenantId   String
  ticketId   String
  productId  String
  qty        Decimal       @db.Decimal(14, 4)
  consumed   Boolean       @default(false)
  ticket     ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

}

model QualityCheck {
  id        String        @id @default(uuid())
  tenantId  String
  ticketId  String
  passed    Boolean
  notes     String?
  createdAt DateTime      @default(now())
  ticket    ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

}

model PickList {
  id           String         @id @default(uuid())
  tenantId     String
  number       String
  salesOrderId String?
  ticketId     String?
  status       String         @default("OPEN")
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  lines        PickListLine[]
  shipments    Shipment[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, number])
}

model PickListLine {
  id         String   @id @default(uuid())
  pickListId String
  productId  String
  qty        Decimal  @db.Decimal(14, 4)
  pickedQty  Decimal  @default(0) @db.Decimal(14, 4)
  pickList   PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
}

model Shipment {
  id            String           @id @default(uuid())
  tenantId      String
  number        String
  pickListId    String?
  ticketId      String?
  courier       String?
  awb           String?
  status        ShipmentStatus   @default(CREATED)
  freight       Decimal          @default(0) @db.Decimal(14, 2)
  packedAt      DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime         @default(now())
  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  pickList      PickList?        @relation(fields: [pickListId], references: [id])
  ticket        ServiceTicket?   @relation(fields: [ticketId], references: [id])
  events        TrackingEvent[]
  proofs        DeliveryProof[]
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model TrackingEvent {
  id         String   @id @default(uuid())
  tenantId   String
  shipmentId String
  status     String
  note       String?
  occurredAt DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

}

model DeliveryProof {
  id         String   @id @default(uuid())
  tenantId   String
  shipmentId String
  kind       String
  url        String?
  signature  String?
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?

}

model RecurringSchedule {
  id           String                @id @default(uuid())
  tenantId     String
  name         String
  kind         RecurringKind
  frequency    RecurrenceFrequency
  interval     Int                   @default(1)
  partyId      String?
  amount       Decimal               @db.Decimal(14, 2)
  taxRate      Decimal               @default(0) @db.Decimal(5, 2)
  nextRunAt    DateTime
  endsAt       DateTime?
  status       ScheduleStatus        @default(ACTIVE)
  dueOffsetDays Int                  @default(0)
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  occurrences  RecurringOccurrence[]
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, nextRunAt])
}

model RecurringOccurrence {
  id         String            @id @default(uuid())
  tenantId   String
  scheduleId String
  occurKey   String
  runAt      DateTime
  invoiceId  String?
  status     String            @default("GENERATED")
  schedule   RecurringSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, occurKey])
}

model BankAccount {
  id            String            @id @default(uuid())
  tenantId      String
  name          String
  maskedNumber  String
  provider      String            @default("manual")
  consentExpiresAt DateTime?
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  transactions  BankTransaction[]
  deletedAt DateTime?
  deletedBy String?

}

model BankTransaction {
  id            String          @id @default(uuid())
  tenantId      String
  bankAccountId String
  providerRef   String
  amount        Decimal         @db.Decimal(14, 2)
  txnDate       DateTime
  description   String
  matchStatus   BankMatchStatus @default(UNMATCHED)
  invoiceId     String?
  paymentId     String?
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, providerRef])
  @@index([tenantId, matchStatus])
}

model ChannelAccount {
  id        String         @id @default(uuid())
  tenantId  String
  provider  String
  name      String
  phone     String?
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  deletedAt DateTime?
  deletedBy String?

}

model Conversation {
  id         String             @id @default(uuid())
  tenantId   String
  channelId  String
  partyId    String?
  leadId     String?
  status     ConversationStatus @default(OPEN)
  optOut     Boolean            @default(false)
  ownerUserId String?
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  channel    ChannelAccount     @relation(fields: [channelId], references: [id])
  messages   Message[]
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, status])
}

model Message {
  id             String       @id @default(uuid())
  tenantId       String
  conversationId String
  direction      String
  body           String
  templateName   String?
  eventId        String?
  status         String       @default("QUEUED")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, eventId])
}

model MarketplaceListing {
  id        String  @id @default(uuid())
  tenantId  String
  channel   String
  productId String
  listingId String
  version   Int     @default(1)
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, channel, listingId])
}

model MarketplaceOrder {
  id            String  @id @default(uuid())
  tenantId      String
  channel       String
  externalId    String
  salesOrderId  String?
  status        String
  payload       Json
  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, channel, externalId])
}

model WebhookEvent {
  id         String   @id @default(uuid())
  tenantId   String?
  provider   String
  eventId    String
  payload    Json
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([provider, eventId])
}

model ImportBatch {
  id           String      @id @default(uuid())
  tenantId     String
  sourceSystem String
  entityType   String
  status       String      @default("DRAFT")
  dryRun       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  rows         ImportRow[]
  deletedAt DateTime?
  deletedBy String?

}

model ImportRow {
  id          String      @id @default(uuid())
  batchId     String
  legacyId    String
  payload     Json
  status      String      @default("PENDING")
  error       String?
  recordId    String?
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@unique([batchId, legacyId])
}

model ExportJob {
  id        String   @id @default(uuid())
  tenantId  String
  reportKey String
  status    String   @default("PENDING")
  fileUrl   String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

}

model ReportRun {
  id         String   @id @default(uuid())
  tenantId   String
  reportKey  String
  filters    Json?
  result     Json
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?

}

model MobileDevice {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  label     String?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@index([tenantId, userId])
}

model OfflineAction {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  deviceId    String?
  idempotencyKey String
  action      String
  payload     Json
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  deletedAt DateTime?
  deletedBy String?
  @@unique([tenantId, idempotencyKey])
}
