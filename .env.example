# Copy to .env in the repo root and to apps/api/.env

NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/refurbiconerp?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/refurbiconerp?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

PLATFORM_ADMIN_EMAIL=admin@refurbicon.local
PLATFORM_ADMIN_PASSWORD=ChangeMe!Admin1
